{
  "name": "neon-table-games",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/write-build-version.cjs && tsc --noEmit && vite build",
    "check": "npm run lint && npm run format:check",
    "dev": "vite",
    "format": "prettier --write \"*.{cjs,json,ts,mts}\" \"scripts/*.{cjs,mjs}\" \"netlify/functions/*.cjs\" \"shared/*.js\" \"blackjack/*.js\" \"baccarat/*.js\" \"three-card-poker/*.js\" \"src/**/*.{ts,tsx,css}\" \"tests/**/*.cjs\"",
    "format:check": "prettier --check \"*.{cjs,json,ts,mts}\" \"scripts/*.{cjs,mjs}\" \"netlify/functions/*.cjs\" \"shared/*.js\" \"blackjack/*.js\" \"baccarat/*.js\" \"three-card-poker/*.js\" \"src/**/*.{ts,tsx,css}\" \"tests/**/*.cjs\"",
    "lint": "eslint .",
    "test": "npm run check && npm run test:unit && npm run test:visual",
    "test:unit": "node --test tests/unit/game-core.test.cjs tests/unit/game-settings.test.cjs tests/unit/session-framework.test.cjs tests/unit/error-monitoring.test.cjs tests/unit/blackjack-engine.test.cjs tests/unit/baccarat-engine.test.cjs tests/unit/baccarat-session.test.cjs tests/unit/three-card-poker-engine.test.cjs tests/unit/statistical-simulations.test.cjs",
    "test:visual": "playwright test",
    "test:visual:headed": "playwright test --headed",
    "test:visual:report": "playwright show-report",
    "test:production": "playwright test --config=playwright.production.config.cjs",
    "test:performance": "npm run build && node scripts/run-lighthouse.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.7.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
